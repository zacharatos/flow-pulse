{
  "name": "flow-pulse",
  "version": "0.1.0",
  "description": "Manage Home Assistant automations from the dashboard: on/off, run, snooze and failed runs at a glance.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./test/register.mjs --test \"test/**/*.test.mjs\""
  },
  "keywords": ["home-assistant", "hacs", "lovelace", "custom-card", "automations", "snooze"],
  "license": "MIT",
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "rollup": "^4.24.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  }
}
